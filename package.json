{
  "name": "rc-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "River connectivity analysis (rc2 numerics) running 100% in the browser",
  "scripts": {
    "predev": "node scripts/fetch-extension.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-extension.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fetch:ext": "node scripts/fetch-extension.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "golden": "Rscript tools/make_golden.R",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e-browser.mjs",
    "golden:ui": "node scripts/make-ui-golden.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "comlink": "4.4.2",
    "maplibre-gl": "5.6.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "24.3.1",
    "playwright-core": "1.55.0",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
